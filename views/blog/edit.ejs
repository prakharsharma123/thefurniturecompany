<%- include('../partials/head') %><%- include('../partials/header') %>
<section class="w" style="max-width:640px"><div class="hd"><small>Blog</small><h2>Edit <span class="gr">post</span></h2></div>
<form class="box" method="POST" action="/blog/<%= post.id %>?_method=PATCH"><label for="t">Title</label><input id="t" name="title" value="<%= post.title %>" required><label for="u">Author</label><input id="u" name="username" value="<%= post.username %>" required><label for="c">Content</label><textarea id="c" name="content" rows="8" required><%= post.content %></textarea><p><button class="btn">Save changes</button> <a class="btn o" href="/blog/<%= post.id %>">Cancel</a></p></form></section>
<%- include('../partials/footer') %>
