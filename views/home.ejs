<%- include('partials/head') %><%- include('partials/header') %>
<div class="hero"><div class="w"><div><span class="pill">🏠 Best modular solutions in Lucknow</span><h1>Explore Our <span class="gr">Modern Modular Collection</span></h1><p>Kitchens, wardrobes, traditional mandirs and control panels, made in our own factory and installed by our own team.</p><a class="btn" href="/shop">Shop now</a> &nbsp; <a href="/shop" style="font-weight:600">View all products</a>
<div class="rate"><div class="av"><span></span><span></span><span></span></div><div><b>4.8 rating</b><br>Trusted by 120+ customers</div></div></div>
<div><div class="slide" id="sl"><% [[0,'Modular Kitchens','120+ projects','Kitchens'],[3,'Wardrobes','80+ projects','Wardrobes'],[5,'Traditional Mandir','40+ projects','Mandir']].forEach(x=>{ %><div><div class="art"><%- imgTag('slide'+x[0], products[x[0]].t, products[x[0]].col, x[1]) %></div><div class="r"><div><h3><%= x[1] %></h3><small><%= x[2] %></small></div><a class="btn" href="/shop?cat=<%= x[3] %>">Go</a></div></div><% }) %></div>
<div class="arr"><button aria-label="Previous" onclick="document.getElementById('sl').scrollBy({left:-300,behavior:'smooth'})">←</button><button aria-label="Next" onclick="document.getElementById('sl').scrollBy({left:300,behavior:'smooth'})">→</button></div></div></div></div>
<div class="w"><div class="feat"><div><b>🚚</b><div><h3>Delivery and installation</h3><p>Across Lucknow and UP</p></div></div><div><b>💳</b><div><h3>Flexible payment</h3><p>UPI, cards, EMI or advance</p></div></div><div><b>🎧</b><div><h3>6-day support</h3><p>Mon to Sat, 10 AM to 6 PM</p></div></div></div>
<section style="padding-top:10px"><div class="bento">
<a class="bc t" href="/shop?cat=Kitchens"><div><span class="n">120+ projects</span><h2>Modular kitchens</h2><ul><li>L-shaped</li><li>Straight</li><li>Island</li><li>U-shaped</li></ul></div><div class="art"><%- imgTag('bento0','k','#C58F4D','Modular kitchens') %></div></a>
<a class="bc" href="/shop?cat=Wardrobes"><div><span class="n">80+ projects</span><h2>Wardrobes</h2><ul><li>Sliding</li><li>Swing door</li></ul></div><div class="art"><%- imgTag('bento1','w','#5B7185','Wardrobes') %></div></a>
<a class="bc" href="/shop?cat=Mandir"><div><span class="n">40+ projects</span><h2>Traditional mandir designs</h2><ul><li>Wooden</li><li>Marble</li></ul></div><div class="art"><%- imgTag('bento2','m','#E8E2D6','Traditional mandir designs') %></div></a></div></section>
<section><div class="hd"><small>Our products</small><h2>Our <span class="gr">Products Collections</span></h2></div>
<div class="tabs"><% [['l','Latest products'],['b','Best sellers'],['f','Featured']].forEach(t=>{ %><a class="tab" style="text-decoration:none" aria-pressed="<%= tab===t[0] %>" href="/home?tab=<%= t[0] %>"><%= t[1] %></a><% }) %></div>
<div class="grid"><% products.filter(p=>p.g.includes(tab)).forEach(p=>{ %><%- include('partials/card',{p}) %><% }) %></div></section>
<section style="padding-top:0"><div class="sale"><div><h2>Flash <span class="gr">Sale!</span></h2><p>Get 25% off wardrobes. Limited time offer.</p><div class="cd" id="cd"></div><a class="btn" href="/shop?cat=Wardrobes">Shop now</a></div><div class="art"><%- imgTag('sale','w','#C58F4D','Wardrobe flash sale') %></div></div></section>
<section style="padding-top:0"><h2 style="margin-bottom:20px">Deals of the <span class="gr">Day</span></h2><div class="deals"><% [3,2].forEach(i=>{ const p=products[i]; %><div class="deal"><div class="art"><%- imgTag('p'+i, p.t, p.col, p.n) %></div><div><small style="color:var(--mut)"><%= p.c %></small><h3><%= p.n %></h3><b><%= inr(p.s[0][1]) %></b><s style="color:var(--mut)"> <%= inr(was(p,0)) %></s><br><a href="/product/<%= i %>" style="font-weight:600;font-size:.85rem">Shop now</a></div></div><% }) %></div>
<div class="promo"><div class="pm"><small>Flat 15% discount</small><h2>Traditional mandir designs</h2><p>Wooden and marble home temples.</p><a class="btn" href="/shop?cat=Mandir">Get quote</a></div><div class="pm y"><small>Flat 20% discount</small><h2>Kitchen cabinets</h2><p>Ready stock wall cabinet sets.</p><a class="btn" href="/shop?cat=Kitchens">Shop now</a></div></div></section></div>
<div class="bg2"><section class="w"><div class="hd"><small>Testimonials</small><h2>What our <span class="gr">clients say</span></h2></div><%- include('partials/reviews',{list:reviews}) %></section></div>
<section class="w"><div class="hd"><small>News and blogs</small><h2>Our latest <span class="gr">news and blogs</span></h2></div><div class="blogs"><% posts.forEach(post=>{ %><%- include('partials/postcard',{post}) %><% }) %></div></section>
<div class="bg2"><section class="w"><div class="hd"><small>Follow us</small><h2>Our completed <span class="gr">projects</span></h2></div><p style="text-align:center"><a class="btn o" href="/projects">See before and after</a></p><div class="gal"><% [0,1,3,5,7,4].forEach((i,j)=>{ %><div class="art"><%- imgTag('g'+j, products[i].t, products[i].col, products[i].n) %></div><% }) %></div></section></div>
<section class="w"><div class="hd"><small>FAQs</small><h2>Question? <span class="gr">Look here.</span></h2></div><div class="faq"><% [['What do you make?','Modular kitchens, wardrobes, traditional mandir designs, control panel boards and interior design.'],['What payment methods do you accept?','UPI, cards, net banking and EMI. Large custom orders can start with a 30% advance.'],['What is your return policy?','Ready products can be returned within 7 days. Custom-made items are non-returnable.'],['Do you deliver and install?','Yes, across Lucknow and UP, by our own team.']].forEach(f=>{ %><details><summary><%= f[0] %></summary><p><%= f[1] %></p></details><% }) %></div></section>
<div class="bg2"><section class="w" style="text-align:center"><div class="hd"><small>Our newsletter</small><h2>Subscribe for updates on our <span class="gr">latest collection</span></h2></div><form class="nl" onsubmit="event.preventDefault();toast('Subscribed, thank you')"><input type="email" aria-label="Email" placeholder="Enter email address" required><button class="btn y">Subscribe</button></form></section></div>
<%- include('partials/footer') %>
