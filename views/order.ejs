<%- include('partials/head') %><%- include('partials/header') %>
<section class="w" style="max-width:640px"><div class="hd"><small>Thank you</small><h2>Order <span class="gr">placed</span></h2></div>
<div class="box"><p>Order number: <b><%= o.id %></b>. Keep it to track your order and to write a review.</p>
<% o.items.forEach(x=>{ %><div class="li"><span><%= x.name %> (<%= x.size %>) x <%= x.q %></span><b><%= inr(x.price*x.q) %></b></div><% }) %><div class="li"><b>Total (GST incl.)</b><b><%= inr(o.total) %></b></div>
<p style="color:var(--mut);font-size:.85rem">Demo checkout. A payment gateway such as Razorpay connects here.</p><a class="btn" href="/shop">Continue shopping</a></div></section>
<script>localStorage.removeItem('c')</script>
<%- include('partials/footer') %>
