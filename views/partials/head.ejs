<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= title %> | PN Modular System</title>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/style.css">
<script>
try{if(!sessionStorage.getItem('pnSplash')&&!matchMedia('(prefers-reduced-motion: reduce)').matches){
document.documentElement.classList.add('splash-on');
setTimeout(function(){document.documentElement.classList.remove('splash-on')},8000)}}catch(e){}
</script>
</head><body>
